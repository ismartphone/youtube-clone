<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde Android à partir de l'API 31. Voir https://developer.android.com/about/versions/12/backup-restore#xml-changes -->
<data-extraction-rules>
    <!-- Tokens de session exclus : voir backup_rules.xml. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
