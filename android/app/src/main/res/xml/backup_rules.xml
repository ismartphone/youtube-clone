<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde Android jusqu'à l'API 30. Voir https://developer.android.com/guide/topics/data/autobackup -->
<full-backup-content>
    <!-- Tokens de session : chiffrés par une clé du Keystore qui n'est pas sauvegardée,
         donc illisibles sur un autre appareil. -->
    <exclude domain="file" path="datastore/session.preferences_pb" />
</full-backup-content>
