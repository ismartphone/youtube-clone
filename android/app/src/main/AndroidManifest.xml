<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Retour du réseau après une bascule de compte hors ligne : jeton de notification rejoué (ADR-022). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lecture en arrière-plan des comptes Premium (PlaybackService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Téléchargements hors ligne (ADR-019) : service au premier plan et sa notification de progression. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibrations du parcours d'accueil (ADR-028) ; permission normale, accordée à l'installation. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- networkSecurityConfig : HTTP vers 10.0.2.2 autorisé en debug seulement (voir src/debug). -->
    <application
        android:name=".YoutubeCloneApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Android">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported : les contrôles système (notification, écran verrouillé) s'y connectent. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Téléchargements hors ligne (ADR-019), dans le stockage privé de l'application. -->
        <service
            android:name=".playback.download.AppDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Notifications de publication par Firebase Cloud Messaging (ADR-020). -->
        <service
            android:name=".notifications.PublicationMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
