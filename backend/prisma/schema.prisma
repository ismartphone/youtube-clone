// Modèle de données du clone de YouTube (voir CLAUDE.md et docs/adr/).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// VISITOR existe dans l'enum mais n'est jamais stocké : un visiteur n'a pas de compte.
enum Role {
  VISITOR
  USER
  CREATOR
  ADMIN
}

enum VideoVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum LikeType {
  LIKE
  DISLIKE
}

// Cloche d'un abonnement (ADR-020). PERSONALIZED : vidéos classiques seulement, sans les Shorts.
enum NotificationLevel {
  ALL
  PERSONALIZED
  NONE
}

enum VideoFormat {
  SHORT
  LONG
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  channel                     Channel?
  comments                    Comment[]
  commentLikes                CommentLike[]
  conversationsAsA            Conversation[]        @relation("ConversationUserA")
  conversationsAsB            Conversation[]        @relation("ConversationUserB")
  messages                    Message[]
  // Notifications des messages reçus (ADR-025, étape 3), réglées dans Paramètres.
  messageNotificationsEnabled Boolean               @default(true)
  likes                       Like[]
  follows                     Follow[]
  premiumSubscriptions        PremiumSubscription[]
  watchHistory                WatchHistory[]
  playlists                   Playlist[]
  deviceTokens                DeviceToken[]
  liveMessages                LiveMessage[]
  livePurchases               LivePurchase[]

  @@map("users")
}

// Jeton FCM d'un appareil connecté (ADR-020) ; plusieurs appareils par utilisateur. Un jeton
// n'appartient qu'à un compte : la connexion d'un autre compte sur l'appareil le reprend.
model DeviceToken {
  token     String   @id
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// Une seule chaîne par utilisateur : simplification assumée pour le socle.
model Channel {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @unique @db.Uuid
  name        String
  handle      String   @unique
  description String?
  avatarUrl   String?
  // Bannière en haut de la page de chaîne : URL ou chemin relatif (/media/banners/...).
  bannerUrl   String?
  createdAt   DateTime @default(now())

  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  videos    Video[]
  followers Follow[]
  posts     Post[]
  lives     Live[]
  products  Product[]

  @@map("channels")
}

model Category {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  videos Video[]

  @@map("categories")
}

// Post publié par une chaîne depuis l'application (ADR-015) : texte, image facultative
// (chemin relatif /media/posts/...), date. Création réservée au propriétaire, lecture publique.
model Post {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @db.Uuid
  text      String
  imageUrl  String?
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt(sort: Desc)]) // onglet Posts de la page de chaîne
  @@map("posts")
}

// La base ne stocke que les URL des fichiers, jamais les fichiers eux-mêmes.
model Video {
  id              String          @id @default(uuid()) @db.Uuid
  channelId       String          @db.Uuid
  categoryId      String?         @db.Uuid
  title           String
  description     String?
  videoUrl        String
  thumbnailUrl    String
  // Manifeste HLS multi-qualités (ADR-017), chemin relatif /media/hls/<identifiant aléatoire>/master.m3u8 ;
  // null tant qu'il n'est pas généré, ou pour une vidéo externe : le MP4 sert alors de repli.
  hlsUrl          String?
  // Sous-titres générés automatiquement (ADR-017), chemin relatif /media/subtitles/<identifiant aléatoire>.vtt ;
  // null tant qu'ils ne sont pas générés, pour une vidéo externe, ou si la transcription a échoué.
  subtitleUrl     String?
  durationSeconds Int
  format          VideoFormat
  isPremium       Boolean         @default(false)
  // Qui voit l'entrée (ADR-016) : publique, non répertoriée (lien direct seulement) ou privée
  // (propriétaire seulement). Indépendant de isPremium, qui dit qui peut la lire.
  visibility      VideoVisibility @default(PUBLIC)
  // Commentaires activés (ADR-016). Désactivés : masqués, jamais supprimés, et refusés par l'API.
  commentsEnabled Boolean         @default(true)
  viewCount       Int             @default(0)
  // Compteur dénormalisé des lignes Like, reporté depuis Redis par lot (ADR-004).
  likeCount       Int             @default(0)
  publishedAt     DateTime        @default(now())
  // Date d'envoi des notifications de publication (ADR-020) : une vidéo ne notifie qu'une fois.
  notifiedAt      DateTime?

  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments      Comment[]
  likes         Like[]
  watchHistory  WatchHistory[]
  playlistItems PlaylistItem[]
  lives         Live[]

  @@index([format, publishedAt(sort: Desc)]) // fil d'accueil et onglet Shorts
  @@index([channelId, format, publishedAt(sort: Desc)]) // page de chaîne
  @@index([categoryId])
  @@map("videos")
}

model Comment {
  id               String    @id @default(uuid()) @db.Uuid
  videoId          String    @db.Uuid
  userId           String    @db.Uuid
  content          String
  createdAt        DateTime  @default(now())
  // Réponse (ADR-023) : toujours un commentaire de premier niveau de la même vidéo, un seul niveau.
  parentId         String?   @db.Uuid
  // Nombre de « j'aime », tenu à jour dans la même transaction que COMMENT_LIKE (tri « Top »).
  likeCount        Int       @default(0)
  // Cœur du propriétaire de la chaîne ; null sans cœur.
  creatorHeartedAt DateTime?

  video   Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([videoId, createdAt(sort: Desc)])
  @@index([videoId, parentId, likeCount(sort: Desc), createdAt(sort: Desc)])
  @@index([parentId, createdAt])
  @@map("comments")
}

// « J'aime » et « Je n'aime pas » sur un commentaire (ADR-023), sur le modèle de LIKE : un seul
// avis par utilisateur et par commentaire. Seuls les « j'aime » sont comptés.
model CommentLike {
  userId    String   @db.Uuid
  commentId String   @db.Uuid
  type      LikeType @default(LIKE)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

// « J'aime » ou « Je n'aime pas » (ADR-019) : une seule ligne par utilisateur et par vidéo, donc
// les deux avis s'excluent. Le nombre de « Je n'aime pas » n'est jamais calculé ni affiché.
model Like {
  userId    String   @db.Uuid
  videoId   String   @db.Uuid
  type      LikeType @default(LIKE)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
  @@map("likes")
}

// Abonnement gratuit à une chaîne, à ne pas confondre avec PremiumSubscription.
model Follow {
  userId            String            @db.Uuid
  channelId         String            @db.Uuid
  createdAt         DateTime          @default(now())
  // Choix de la cloche (ADR-020) ; Personnalisées par défaut.
  notificationLevel NotificationLevel @default(PERSONALIZED)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
  @@map("follows")
}

// Abonnement payant, actif tant que expiresAt est dans le futur (ADR-007).
model PremiumSubscription {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  purchaseToken String   @unique // référence du paiement : identifiant du PaymentIntent Stripe, ou jeton simulé de repli (ADR-014)
  startedAt     DateTime @default(now())
  expiresAt     DateTime
  // Ce qui a réellement été payé, enregistré à l'achat (en centimes, devise ISO en minuscules) :
  // l'historique reste juste même si le prix de l'offre change.
  amount        Int
  currency      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("premium_subscriptions")
}

// Une ligne par couple utilisateur et vidéo, watchedAt mis à jour à chaque visionnage.
model WatchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  videoId   String   @db.Uuid
  watchedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, watchedAt(sort: Desc)])
  @@map("watch_history")
}

// Playlist d'un utilisateur (ADR-019) : privée, seul son propriétaire la voit ; vidéos dans l'ordre
// d'ajout. 50 playlists par utilisateur, 200 vidéos par playlist, vérifiés par le serveur.
model Playlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("playlists")
}

// Une vidéo ne figure qu'une fois dans une playlist ; elle en disparaît si elle est supprimée.
model PlaylistItem {
  playlistId String   @db.Uuid
  videoId    String   @db.Uuid
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([playlistId, videoId])
  @@index([videoId])
  @@map("playlist_items")
}

// Publicité vidéo (ADR-021) : lue avant les vidéos et dans le bandeau sponsorisé des comptes non
// Premium, tirée au sort parmi toutes les lignes. Ce n'est pas une vidéo du catalogue.
model Ad {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  videoUrl        String
  // Échelle HLS générée en tâche de fond après l'import ; le MP4 est lu en attendant.
  hlsUrl          String?
  thumbnailUrl    String?
  durationSeconds Int
  // Site de l'annonceur, ouvert par « Visiter le site » et par le bandeau sponsorisé. Saisi à
  // l'import ; null seulement pour une ligne antérieure à ce champ.
  destinationUrl  String?
  // Carte du bandeau sponsorisé : nom de l'annonceur, description courte, logo carré facultatif
  // (sinon son initiale) et libellé du bouton principal, repris par la bande pendant l'annonce.
  // Nom et description : null seulement pour une ligne antérieure à ces champs.
  advertiserName  String?
  description     String?
  logoUrl         String?
  ctaLabel        String   @default("Visiter le site")
  createdAt       DateTime @default(now())

  @@map("ads")
}

// Conversation à deux (ADR-025). La paire est rangée dans l'ordre (le plus petit identifiant en A) :
// une seule conversation par paire, et jamais avec soi-même (vérifié par le domaine).
model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  userAId       String    @db.Uuid
  userBId       String    @db.Uuid
  lastMessageAt DateTime?
  // Dernière lecture de chaque participant : les messages de l'autre plus récents sont non lus.
  readAtA       DateTime?
  readAtB       DateTime?
  createdAt     DateTime  @default(now())

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("conversations")
}

// Message d'une conversation (ADR-025) : 2000 caractères au plus, ni modifié ni supprimé.
model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  senderId       String   @db.Uuid
  // Vide quand une vidéo est partagée sans texte.
  content        String
  // Vidéo partagée (ADR-025, étape 2). Sans clé étrangère : une vidéo supprimée depuis garde son
  // identifiant ici, et le message s'affiche « Vidéo indisponible » au lieu de passer pour un texte.
  videoId        String?  @db.Uuid
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([videoId])
  @@map("messages")
}

// État d'un live (ADR-029) : en direct, ou terminé par son diffuseur.
enum LiveStatus {
  LIVE
  ENDED
}

// Nature d'un message du chat d'un live : écrit par un spectateur, ou annonce d'un achat écrite
// par le serveur (ADR-029, étape 3).
enum LiveMessageKind {
  CHAT
  PURCHASE
}

// Live shopping (ADR-029) : direct simulé, dont le flux est une vidéo du catalogue lue en boucle.
// Un seul live en cours par chaîne (vérifié par le cas d'usage, dans une transaction).
model Live {
  id              String     @id @default(uuid()) @db.Uuid
  channelId       String     @db.Uuid
  title           String
  // Vidéo du catalogue utilisée comme flux. Supprimée depuis : la ligne du live est conservée,
  // videoId devient vide (le live terminé reste lisible dans le back-office).
  videoId         String?    @db.Uuid
  status          LiveStatus @default(LIVE)
  startedAt       DateTime   @default(now())
  endedAt         DateTime?
  // Produit épinglé pendant le live (ADR-029). Produit supprimé : il est retiré du live.
  pinnedProductId String?    @db.Uuid

  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  video         Video?         @relation(fields: [videoId], references: [id], onDelete: SetNull)
  pinnedProduct Product?       @relation("PinnedProduct", fields: [pinnedProductId], references: [id], onDelete: SetNull)
  messages      LiveMessage[]
  purchases     LivePurchase[]

  @@index([status, startedAt(sort: Desc)]) // lives en cours, accueil
  @@index([channelId, status])
  @@map("lives")
}

// Chat d'un live (ADR-029).
model LiveMessage {
  id        String          @id @default(uuid()) @db.Uuid
  liveId    String          @db.Uuid
  userId    String          @db.Uuid
  kind      LiveMessageKind @default(CHAT)
  content   String
  createdAt DateTime        @default(now())

  live Live @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([liveId, createdAt(sort: Desc)])
  @@map("live_messages")
}

// Produit d’une chaîne, vendu pendant ses lives (ADR-029). Géré par le back-office (D11).
// Prix en centimes ; l’image est un chemin relatif /media/product-images/... (ADR-011).
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  channelId   String   @db.Uuid
  name        String
  price       Int
  currency    String   @default("eur")
  imageUrl    String
  description String
  createdAt   DateTime @default(now())

  channel   Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pinnedIn  Live[]         @relation("PinnedProduct")
  purchases LivePurchase[]

  @@index([channelId, createdAt(sort: Desc)])
  @@map("products")
}

// Achat d’un produit pendant un live (ADR-029). Le nom et le montant sont recopiés à l’achat :
// l’historique reste juste si le produit change ou disparaît. paymentReference est unique : un
// même paiement ne sert qu’une fois (ADR-014).
model LivePurchase {
  id               String   @id @default(uuid()) @db.Uuid
  liveId           String   @db.Uuid
  buyerId          String   @db.Uuid
  productId        String?  @db.Uuid
  productName      String
  amount           Int
  currency         String
  paymentReference String   @unique
  createdAt        DateTime @default(now())

  live    Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  buyer   User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([liveId, createdAt(sort: Desc)])
  @@map("live_purchases")
}
