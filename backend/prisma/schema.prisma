// Modèle de données du clone de YouTube (voir CLAUDE.md et docs/adr/).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// VISITOR existe dans l'enum mais n'est jamais stocké : un visiteur n'a pas de compte.
enum Role {
  VISITOR
  USER
  CREATOR
  ADMIN
}

enum VideoVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum LikeType {
  LIKE
  DISLIKE
}

enum VideoFormat {
  SHORT
  LONG
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  channel              Channel?
  comments             Comment[]
  likes                Like[]
  follows              Follow[]
  premiumSubscriptions PremiumSubscription[]
  watchHistory         WatchHistory[]

  @@map("users")
}

// Une seule chaîne par utilisateur : simplification assumée pour le socle.
model Channel {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @unique @db.Uuid
  name        String
  handle      String   @unique
  description String?
  avatarUrl   String?
  // Bannière en haut de la page de chaîne : URL ou chemin relatif (/media/banners/...).
  bannerUrl   String?
  createdAt   DateTime @default(now())

  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  videos    Video[]
  followers Follow[]
  posts     Post[]

  @@map("channels")
}

model Category {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  videos Video[]

  @@map("categories")
}

// Post publié par une chaîne depuis l'application (ADR-015) : texte, image facultative
// (chemin relatif /media/posts/...), date. Création réservée au propriétaire, lecture publique.
model Post {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @db.Uuid
  text      String
  imageUrl  String?
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt(sort: Desc)]) // onglet Posts de la page de chaîne
  @@map("posts")
}

// La base ne stocke que les URL des fichiers, jamais les fichiers eux-mêmes.
model Video {
  id              String          @id @default(uuid()) @db.Uuid
  channelId       String          @db.Uuid
  categoryId      String?         @db.Uuid
  title           String
  description     String?
  videoUrl        String
  thumbnailUrl    String
  // Manifeste HLS multi-qualités (ADR-017), chemin relatif /media/hls/<identifiant aléatoire>/master.m3u8 ;
  // null tant qu'il n'est pas généré, ou pour une vidéo externe : le MP4 sert alors de repli.
  hlsUrl          String?
  // Sous-titres générés automatiquement (ADR-017), chemin relatif /media/subtitles/<identifiant aléatoire>.vtt ;
  // null tant qu'ils ne sont pas générés, pour une vidéo externe, ou si la transcription a échoué.
  subtitleUrl     String?
  durationSeconds Int
  format          VideoFormat
  isPremium       Boolean         @default(false)
  // Qui voit l'entrée (ADR-016) : publique, non répertoriée (lien direct seulement) ou privée
  // (propriétaire seulement). Indépendant de isPremium, qui dit qui peut la lire.
  visibility      VideoVisibility @default(PUBLIC)
  // Commentaires activés (ADR-016). Désactivés : masqués, jamais supprimés, et refusés par l'API.
  commentsEnabled Boolean         @default(true)
  viewCount       Int             @default(0)
  // Compteur dénormalisé des lignes Like, reporté depuis Redis par lot (ADR-004).
  likeCount       Int             @default(0)
  publishedAt     DateTime        @default(now())

  channel      Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments     Comment[]
  likes        Like[]
  watchHistory WatchHistory[]

  @@index([format, publishedAt(sort: Desc)]) // fil d'accueil et onglet Shorts
  @@index([channelId, format, publishedAt(sort: Desc)]) // page de chaîne
  @@index([categoryId])
  @@map("videos")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  videoId   String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt(sort: Desc)])
  @@map("comments")
}

// « J'aime » ou « Je n'aime pas » (ADR-019) : une seule ligne par utilisateur et par vidéo, donc
// les deux avis s'excluent. Le nombre de « Je n'aime pas » n'est jamais calculé ni affiché.
model Like {
  userId    String   @db.Uuid
  videoId   String   @db.Uuid
  type      LikeType @default(LIKE)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
  @@map("likes")
}

// Abonnement gratuit à une chaîne, à ne pas confondre avec PremiumSubscription.
model Follow {
  userId    String   @db.Uuid
  channelId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
  @@map("follows")
}

// Abonnement payant, actif tant que expiresAt est dans le futur (ADR-007).
model PremiumSubscription {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  purchaseToken String   @unique // référence du paiement : identifiant du PaymentIntent Stripe, ou jeton simulé de repli (ADR-014)
  startedAt     DateTime @default(now())
  expiresAt     DateTime
  // Ce qui a réellement été payé, enregistré à l'achat (en centimes, devise ISO en minuscules) :
  // l'historique reste juste même si le prix de l'offre change.
  amount        Int
  currency      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("premium_subscriptions")
}

// Une ligne par couple utilisateur et vidéo, watchedAt mis à jour à chaque visionnage.
model WatchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  videoId   String   @db.Uuid
  watchedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, watchedAt(sort: Desc)])
  @@map("watch_history")
}
