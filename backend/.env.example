# Copier ce fichier en .env et adapter les valeurs.
# Les valeurs ci-dessous correspondent au docker-compose.yml de la racine.
DATABASE_URL="postgresql://youtube:youtube@localhost:5432/youtube?schema=public"
REDIS_URL="redis://localhost:6379"
# Secrets de signature des tokens, distincts et longs. Pour en générer un :
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="a-remplacer"
JWT_REFRESH_SECRET="a-remplacer-aussi"
# Paiement Premium par Stripe en mode test (ADR-014), facultatif : sans STRIPE_SECRET_KEY,
# l'achat simulé prend le relais. Clés de test du tableau de bord Stripe, jamais versionnées.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Notifications par Firebase Cloud Messaging (ADR-020), facultatif : chemin de la clé de compte de
# service (console Firebase → Paramètres du projet → Comptes de service), jamais versionnée.
# Sans elle, le serveur démarre sans notifications.
# FIREBASE_SERVICE_ACCOUNT="firebase-service-account.json"
# Live partagé entre les applications de la classe (ADR-031), facultatif : sans LIVE_SDK_APP_ID et
# LIVE_SDK_SECRET, POST /live/participant-token répond 503 et le reste du serveur fonctionne.
# Identifiant de notre App membre et secret HS256, transmis en privé par le serveur commun, jamais
# versionnés. LIVE_SDK_SERVER_URL : adresse du serveur commun, pour référence (l'application Android
# la reçoit par la propriété Gradle liveServerUrl).
LIVE_SDK_SERVER_URL=
LIVE_SDK_APP_ID=
LIVE_SDK_SECRET=
