# Copier ce fichier en .env et adapter les valeurs.
# Les valeurs ci-dessous correspondent au docker-compose.yml de la racine.
DATABASE_URL="postgresql://youtube:youtube@localhost:5432/youtube?schema=public"
REDIS_URL="redis://localhost:6379"
# Secrets de signature des tokens, distincts et longs. Pour en générer un :
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="a-remplacer"
JWT_REFRESH_SECRET="a-remplacer-aussi"
